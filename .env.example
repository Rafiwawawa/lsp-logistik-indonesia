# Application Environment
NODE_ENV=development
PORT=4000

# Security Secrets (Minimum 32 bytes cryptographically secure random string)
SESSION_SECRET=change-this-to-a-secure-32-byte-secret-key-at-least

# Database Paths (Persistent SQLite)
DATABASE_PATH=./database/lsp.db
SESSION_DATABASE_PATH=./database/sessions.db

# File Storage
UPLOAD_DIR=./uploads

# Initial Administrator Setup Token (Required before first admin is created)
# Must be passed in X-Setup-Token header during POST /api/auth/setup
SETUP_TOKEN=change-this-setup-token-to-a-secure-random-value
